# Digest-sealed trees must check out byte-identical on every host.
# CRLF conversion breaks vendored tree digests, repair evidence hashes,
# and unified-diff context matching.
capabilities/absorbed/** text eol=lf
stewardship/** text eol=lf
# Absorption fixtures are re-vendored into sealed trees: they must also
# check out byte-identical, or re-absorption on CRLF hosts corrupts digests.
tests/fixtures/** text eol=lf
# Vendored release archives are binary: EOL normalization corrupts their
# gzip streams (this is what broke the mistune-3.2.1 sdist provenance pin).
stewardship/**/*.tar.gz binary
capabilities/absorbed/**/*.tar.gz binary
capabilities/absorbed/**/*.whl binary
capabilities/absorbed/**/*.zip binary
