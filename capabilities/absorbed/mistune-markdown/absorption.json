{
  "schema_version": 1,
  "slug": "mistune-markdown",
  "name": "mistune markdown renderer (github.com/lepture/mistune)",
  "version": "3.4.0",
  "origin": {
    "kind": "git",
    "source": "https://github.com/lepture/mistune",
    "commit": "75cab785a339eadfa7e760ed7ab2b0a3ad98c642"
  },
  "command": ["python", "absorption_adapter.py"],
  "requires": ["markdown_source"],
  "provides": ["rendered_html"],
  "cases": [
    {"input": {"markdown_source": "# Blackhole"}, "expect": {"rendered_html": "<h1>Blackhole</h1>\n"}},
    {"input": {"markdown_source": "**unbound** growth"}, "expect": {"rendered_html": "<p><strong>unbound</strong> growth</p>\n"}},
    {"input": {"markdown_source": "- absorb\n- prove\n- compose"}, "expect": {"rendered_html": "<ul>\n<li>absorb</li>\n<li>prove</li>\n<li>compose</li>\n</ul>\n"}}
  ]
}
