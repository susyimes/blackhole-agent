+        # Apply the pattern left to right over an evolving buffer, rebuilding
+        # only the buffer tail instead of rescanning the whole string from
+        # the start after every accepted match (which makes n matches in one
+        # text node cost O(n^2)). The buffer always reflects every
+        # substitution made so far, so lookbehind and `handleMatch` see the
+        # same substituted context as a full rescan. `FLUSH_KEEP` characters
+        # of context are retained behind the scan position when the buffer is
+        # flushed, and any pass that stashed at least one element is followed
+        # by a full re-pass, so the fixed point matches the rescan semantics.
+        _FLUSH_AT = 4096
+        _FLUSH_KEEP = 64
